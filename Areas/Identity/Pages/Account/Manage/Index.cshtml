@page
@model IndexModel
@inject SignInManager<ApplicationUser> SignInManager

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Профил";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="profile-page fade-in">

    <div class="profile-container">

        <div class="profile-header">
            <h1>Настройки на профила</h1>
            <p>Актуализирайте личната си информация</p>
        </div>

        <div class="profile-card">

            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="profile-form" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="Input.Username">Потребителско име</label>
                        <input asp-for="Input.Username"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.FirstName">Име</label>
                        <input asp-for="Input.FirstName"
                               class="form-control" />
                        <span asp-validation-for="Input.FirstName"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.MiddleName">Презиме</label>
                        <input asp-for="Input.MiddleName"
                               class="form-control" />
                        <span asp-validation-for="Input.MiddleName"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.LastName">Фамилия</label>
                        <input asp-for="Input.LastName"
                               class="form-control" />
                        <span asp-validation-for="Input.LastName"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Input.PhoneNumber">Телефон</label>
                        <input asp-for="Input.PhoneNumber"
                               class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber"></span>
                    </div>

                </div>

                <div class="profile-actions">
                    <button type="submit" class="btn-save">
                        Запази промените
                    </button>
                </div>

            </form>

        </div>

    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
