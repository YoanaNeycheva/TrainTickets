@model TrainTickets.Models.Station

@section Styles {
    <link rel="stylesheet" href="~/css/create-or-edit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
}

<div class="page-container fade-in">

    <h1 class="page-title text-center">Създай жп гара</h1>
    <p class="page-subtitle text-center">Добавяне на нова жп гара</p>

    <div class="form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger pb-1"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="City" class="control-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    + Добави жп гара
                </button>
            </div>
        </form>
    </div>
    <div class="container w-75 mt-3 p-0 actions">
        <a asp-action="Index" class="action-secondary">
            ← Обратно
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
