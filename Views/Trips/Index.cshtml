@model IEnumerable<TrainTickets.Models.Trip>

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
}

<div class="page-container fade-in">

    <div class="page-header">
        <h1 class="page-title">Превози</h1>

        <a asp-action="Create" class="btn-primary-custom">
            + Създай нов превоз
        </a>
    </div>

    <div class="custom-table-wrapper">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Влак</th>
                    <th>Начална гара</th>
                    <th>Крайна гара</th>
                    <th>Отпътуване</th>
                    <th>Пристигане</th>
                    <th>Цена</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold train-name">

                            @if (item.Train.Type == TrainTickets.Enums.TrainType.Fast)
                            {
                                <i class="fa-solid fa-train train-fast"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-train train-passenger"></i>
                            }

                            @item.Train.Name
                        </td>
                        <td>@item.StartStation.City</td>
                        <td>@item.EndStation.City</td>
                        <td>@item.DepartureTime.ToString("dd.MM.yyyy г. HH:mm")</td>
                        <td>@item.ArrivalTime.ToString("dd.MM.yyyy г. HH:mm")</td>
                        <td class="price">@item.Price.ToString("F2") €</td>
                        <td class="actions">
                            @if (item.DepartureTime < DateTime.Now)
                            {
                                <a class="action-btn edit disabled" aria-disabled="true">
                                    Редактиране
                                </a>
                            }
                            else
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn edit">Редактиране</a>
                            }
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn details">Детайли</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn delete">Изтриване</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
